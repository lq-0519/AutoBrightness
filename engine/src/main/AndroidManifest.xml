<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.codex.autobrightness.engine" android:versionCode="3" android:versionName="1.1.0">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="28" />
    <permission android:name="com.codex.autobrightness.engine.permission.CONTROL"
        android:protectionLevel="signature" android:label="配置亮度控制服务" />
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />
    <uses-permission android:name="android.car.permission.CAR_POWER" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- No Activity or LAUNCHER filter: this independent package has no desktop icon. -->
    <!-- No sharedUserId or shared process: stopping the settings package leaves this UID separate. -->
    <application android:label="随光亮度后台服务" android:icon="@drawable/ic_sun" android:allowBackup="false">
        <service android:name="com.codex.autobrightness.BrightnessService" android:exported="true"
            android:permission="com.codex.autobrightness.engine.permission.CONTROL" android:stopWithTask="false" />
        <receiver android:name="com.codex.autobrightness.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
